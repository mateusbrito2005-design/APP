# Postgres connection string (see root docker-compose.yml for local dev)
DATABASE_URL="postgresql://utmtrack:utmtrack@localhost:5432/utmtrack?schema=public"

# Random long string used to sign JWTs
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API listens on
PORT=4000

# Base public URL of this API (used to build tracking-link and webhook URLs)
PUBLIC_API_URL="http://localhost:4000"

# Comma-separated list of origins allowed to call the API from the browser
WEB_ORIGIN="http://localhost:5173"
